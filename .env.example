# Which ghost this process should be. Must match characters/<id>.yaml.
# mordy  → /seance /haunt /lore /interact
# finley → /seance /watch /lore /interact
# maynard → /ask /watch /experiment  (no /interact)
GHOST_ID=mordy

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional override for the ghost's display name (defaults to the character YAML)
# GHOST_NAME=Mordy Velmora

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: restrict the ghost to specific channel IDs (comma-separated).
# Leave blank to let it haunt every channel it can see.
HAUNT_CHANNEL_IDS=

# Optional: comma-separated guild IDs this ghost is allowed to stay in.
# ALLOWED_GUILD_IDS=

# Optional: guild id for instant slash-command sync while testing.
# DEV_GUILD_ID=

# Optional: directory for mutable state (memory_store.json). On Railway, point
# this at a mounted volume so memory survives redeploys. Do NOT mount a volume
# over the image's data/lore/ path — that would hide shared lore files.
# STATE_DIR=/data

# Peer ghost bot user IDs for /interact (Mordy + Finley only; Maynard skips these).
# Mordy (GHOST_ID=mordy): slot 1 = Finley, slot 2 = Cassy.
# Finley (GHOST_ID=finley): slot 1 = Mordy, slot 2 = Cassy.
# OTHER_GHOST_1_ID=
# OTHER_GHOST_1_NAME=
# OTHER_GHOST_2_ID=
# OTHER_GHOST_2_NAME=Cassy Caldrin
